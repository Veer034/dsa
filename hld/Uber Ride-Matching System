## Surge Pricing Service

```java
@Service
public class SurgePricingService {

    @Autowired private StringRedisTemplate redis;

    /**
     * Surge multiplier based on demand/supply ratio in a geohash cell.
     */
    public double getSurgeMultiplier(String cityId, String geohash) {
        String demandKey = "demand:" + cityId + ":" + geohash; // pending ride requests
        String supplyKey = "supply:" + cityId + ":" + geohash; // available drivers

        long demand = Long.parseLong(
            Optional.ofNullable(redis.opsForValue().get(demandKey)).orElse("0"));
        long supply = Long.parseLong(
            Optional.ofNullable(redis.opsForValue().get(supplyKey)).orElse("1"));

        double ratio = supply == 0 ? 5.0 : (double) demand / supply;

        if (ratio < 0.5) return 1.0;   // undersupply
        if (ratio < 1.0) return 1.2;
        if (ratio < 2.0) return 1.5;
        if (ratio < 3.0) return 2.0;
        return 2.5;                     // extreme demand
    }
}
```

