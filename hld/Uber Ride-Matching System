## Matching Service

```java
@Service
public class MatchingService {

    @Autowired private StringRedisTemplate redis;
    @Autowired private DriverService driverService;
    @Autowired private NotificationService notificationService;
    @Autowired private RideRepository rideRepository;

    private static final double INITIAL_RADIUS_KM = 3.0;
    private static final double MAX_RADIUS_KM = 10.0;
    private static final int MAX_CANDIDATES = 5;

    public MatchResult matchRider(RideRequest request) {
        String rideId = UUID.randomUUID().toString();
        saveRideRequest(rideId, request);

        double radius = INITIAL_RADIUS_KM;

        while (radius <= MAX_RADIUS_KM) {
            List<DriverCandidate> candidates = findNearbyAvailableDrivers(
                request.getPickupLat(), request.getPickupLon(),
                request.getCityId(), radius, MAX_CANDIDATES
            );

            for (DriverCandidate candidate : candidates) {
                boolean accepted = offerRideToDriver(rideId, candidate, request);
                if (accepted) {
                    confirmMatch(rideId, candidate.getDriverId(), request.getRiderId());
                    return MatchResult.success(rideId, candidate);
                }
            }

            radius += 2.0; // expand radius and retry
        }

        updateRideStatus(rideId, RideStatus.NO_DRIVER_FOUND);
        return MatchResult.failure("No available driver found");
    }

    private List<DriverCandidate> findNearbyAvailableDrivers(double lat, double lon,
                                                               String cityId, double radius,
                                                               int limit) {
        String geoKey = "drivers:geo:" + cityId;

        GeoResults<RedisGeoCommands.GeoLocation<String>> results =
            redis.opsForGeo().radius(geoKey,
                new Circle(new Point(lon, lat),
                           new Distance(radius, RedisGeoCommands.DistanceUnit.KILOMETERS)),
                RedisGeoCommands.GeoRadiusCommandArgs.newGeoRadiusArgs()
                    .includeDistance()
                    .sortAscending()
                    .limit(limit * 3) // over-fetch, filter below
            );

        return results.getContent().stream()
            .map(r -> {
                String driverId = r.getContent().getName();
                Map<Object, Object> meta = redis.opsForHash().entries("driver:meta:" + driverId);
                return new DriverCandidate(driverId, r.getDistance().getValue(),
                                           meta, driverService.getRating(driverId));
            })
            .filter(c -> "AVAILABLE".equals(c.getStatus()))
            .filter(c -> matchesVehicleType(c, /* request type */ null))
            .sorted(Comparator.comparingDouble(c -> computeScore(c, lat, lon)))
            .limit(limit)
            .collect(Collectors.toList());
    }

    private double computeScore(DriverCandidate candidate, double riderLat, double riderLon) {
        // Lower score = better match
        double distancePenalty = candidate.getDistanceKm() * 10;
        double ratingBonus = (5.0 - candidate.getRating()) * 5;
        return distancePenalty + ratingBonus;
    }

    private boolean offerRideToDriver(String rideId, DriverCandidate candidate,
                                       RideRequest request) {
        // Atomic: mark driver as PENDING to prevent double-matching
        Boolean locked = redis.opsForValue().setIfAbsent(
            "driver:lock:" + candidate.getDriverId(), rideId, Duration.ofSeconds(15));
        if (Boolean.FALSE.equals(locked)) return false; // driver already locked

        // Send push notification to driver
        notificationService.sendRideOffer(candidate.getDriverId(), rideId, request);

        // Wait for driver acceptance (poll Redis for up to 10 seconds)
        return waitForDriverResponse(candidate.getDriverId(), rideId, 10);
    }

    private boolean waitForDriverResponse(String driverId, String rideId, int timeoutSeconds) {
        String responseKey = "driver:response:" + driverId + ":" + rideId;
        for (int i = 0; i < timeoutSeconds * 2; i++) {
            String response = redis.opsForValue().get(responseKey);
            if ("ACCEPTED".equals(response)) {
                redis.delete(responseKey);
                return true;
            }
            if ("REJECTED".equals(response)) {
                redis.delete("driver:lock:" + driverId);
                redis.delete(responseKey);
                return false;
            }
            try { Thread.sleep(500); } catch (InterruptedException ignored) {}
        }
        // Timeout — release lock, try next driver
        redis.delete("driver:lock:" + driverId);
        return false;
    }
}
```

