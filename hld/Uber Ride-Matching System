## Location Service (Real-Time GPS Ingestion)

```java
@RestController
@RequestMapping("/api/v1/location")
public class LocationController {

    @Autowired private LocationService locationService;

    @PostMapping("/driver")
    public ResponseEntity<Void> updateLocation(@RequestBody LocationUpdate update,
                                               @AuthenticationPrincipal String driverId) {
        locationService.updateDriverLocation(driverId, update.getLat(), update.getLon());
        return ResponseEntity.accepted().build();
    }
}

@Service
public class LocationService {

    @Autowired private StringRedisTemplate redis;
    @Autowired private KafkaTemplate<String, LocationEvent> kafka;

    private static final String GEO_KEY = "drivers:geo:"; // + cityId

    public void updateDriverLocation(String driverId, double lat, double lon) {
        String cityId = geoResolver.getCityId(lat, lon);
        String geoKey = GEO_KEY + cityId;

        // Update Redis GEO index
        redis.opsForGeo().add(geoKey,
            new RedisGeoCommands.GeoLocation<>(driverId, new Point(lon, lat)));

        // Track driver metadata
        redis.opsForHash().put("driver:meta:" + driverId, "status", "AVAILABLE");
        redis.opsForHash().put("driver:meta:" + driverId, "lat", String.valueOf(lat));
        redis.opsForHash().put("driver:meta:" + driverId, "lon", String.valueOf(lon));
        redis.expire("driver:meta:" + driverId, Duration.ofMinutes(5)); // stale if no update

        // Stream to Kafka for trip tracking + Druid analytics
        kafka.send("driver.location.events",
            new LocationEvent(driverId, lat, lon, Instant.now()));
    }
}
```

